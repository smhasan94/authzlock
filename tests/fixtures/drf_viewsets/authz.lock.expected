      references_request_user: null
    get_queryset:
      overridden: false
      references_request_user: null
    perform_create:
      overridden: false
      references_request_user: null
- path: ^customers/(?P<pk>[^/.]+)\.(?P<format>[a-z0-9]+)/?$
  name: customer-detail
  view: billing.views.CustomerViewSet
  methods:
  - GET
  actions:
    GET: retrieve
  permission_classes:
  - rest_framework.permissions.IsAuthenticated
